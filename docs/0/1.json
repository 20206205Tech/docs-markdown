# Hướng dẫn chạy tự động trong .pre-commit-config.yaml

data = [
    {"abbr": "AI", "eng": "Artificial Intelligence", "vie": "Trí tuệ nhân tạo"},
    {"abbr": "API", "eng": "Application Programming Interface", "vie": "Giao diện lập trình ứng dụng"},
    {"abbr": "LLM", "eng": "Large Language Model", "vie": "Mô hình ngôn ngữ lớn"},
    {"abbr": "RAG", "eng": "Retrieval Augmented Generation", "vie": "Thế hệ tăng cường truy xuất"},
    {"abbr": "DDD", "eng": "Domain Driven Design", "vie": "Thiết kế hướng miền"}
]

# Sắp xếp theo Từ viết tắt (A-Z)
sorted_data = sorted(data, key=lambda x: x["abbr"])

# Tạo tiêu đề bảng Markdown
md_table = "| Từ viết tắt | Tên tiếng Anh | Nghĩa tiếng Việt |\n"
md_table += "| :--- | :--- | :--- |\n"

# Thêm từng dòng dữ liệu vào bảng
for item in sorted_data:
    md_table += f"| {item['abbr']} | {item['eng']} | {item['vie']} |\n"

# Ghi ra file markdown
with open("thuat_ngu.md", "w", encoding="utf-8") as f:
    f.write(md_table)
