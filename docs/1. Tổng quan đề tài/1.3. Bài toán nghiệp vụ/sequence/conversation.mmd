

sequenceDiagram
    actor User
    participant ConvService as Conversation Service
    participant DB as Database
    participant Chatbot as Chatbot Service (gRPC)
    participant LLM as LangGraph + LLM

    %% Khởi tạo kết nối
    User->>+ConvService: POST /code-conversation-service/chats/stream (Yêu cầu SSE)

    %% Kiểm tra điều kiện suy luận & VIP
    alt use_reasoning == true
        ConvService->>+DB: Kiểm tra trạng thái VIP (isVip)
        DB-->>-ConvService: Trả về trạng thái VIP
        alt Không phải VIP
            ConvService-->>User: Trả về lỗi HTTP 403 Forbidden (Hủy luồng)
        end
    end

    %% Gọi sang service AI bằng gRPC
    ConvService->>+Chatbot: Gọi AskAI qua gRPC Stream (query, chat_id, use_reasoning)

    %% Khởi tạo luồng sinh text
    Chatbot->>+LLM: Kích hoạt luồng LangGraph + LLM

    par Luồng sinh dữ liệu (Stream)
        loop Nhận chunks từ LangGraph (type: content / status / metadata)
            LLM-->>Chatbot: Trả về Chunk dữ liệu
            Chatbot-->>ConvService: Gửi AskResponse (id, reply, type) qua gRPC
            ConvService-->>User: Gửi SSE Event { type, message }
        end
    and Luồng Heartbeat (Keep-Alive)
        loop Định kỳ 10 giây/lần
            ConvService-->>User: Gửi SSE Event { type: 'heartbeat', message: 'keep-alive' }
        end
    end

    %% Khi sinh xong, LangGraph kết thúc
    LLM-->>-Chatbot: Tín hiệu kết thúc (Done)

    %% Hậu xử lý (Lưu trữ & Chạy ngầm)
    Note over Chatbot, DB: Chatbot xử lý lưu trữ trước khi ngắt gRPC
    Chatbot->>+DB: Lưu tin nhắn AI (role='ai', full_content, reasoning_steps, sources)
    DB-->>-Chatbot: OK

    opt Nếu chat chưa có tiêu đề
        Chatbot->>Chatbot: Kích hoạt Task chạy ngầm sinh tiêu đề (start_background_topic_generation)
    end
    Chatbot->>Chatbot: Kích hoạt Task chạy ngầm tóm tắt lịch sử (start_background_history_summarization)

    Chatbot-->>-ConvService: Đóng kết nối gRPC Stream
    ConvService-->>-User: Gửi sự kiện kết thúc & Đóng luồng SSE
