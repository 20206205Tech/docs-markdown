Hướng dẫn chỉnh lại toàn bộ sơ đồ Mermaid
theo logic dự án hiện tại


flowchart TD
    Client(["NextJS"])
    Gateway{"Kong API Gateway"}



    Client <-->|"request"| Gateway





    %% Nhóm Database & Storage
    subgraph Databases [Databases & Storage]
        SupabaseDB[("Supabase")]
        NeonDB_Setting[("Neon Postgres")]
        Pinecone[("Pinecone")]
        Qdrant[("Qdrant")]
        NeonDB_Phapdien[("Neon Postgres")]
        R2[("Cloudflare R2")]

        %% Dùng liên kết vô hình để ép thứ tự từ trái sang phải
        R2 ~~~ Qdrant ~~~ Pinecone ~~~ NeonDB_Phapdien
    end



    %% Nhóm Message Broker & Cache
        Kafka[["Kafka Broker\n(Events: payment_success, delete_chat)"]]
        Redis[("Redis & BullMQ\n(Rate Limit, Hủy thanh toán)")]

    %% Nhóm Core Services (Vùng Cốt lõi)
    subgraph CoreDomain [Vùng Cốt lõi - Core Domain]
        ConvService["Conversation Service\n(Quản lý Chat, Bookmark, Share)"]
        ChatbotService["Chatbot Service\n(Langgraph Agentic AI)"]
    end

    %% Nhóm Supporting Services (Vùng Hỗ trợ)
    subgraph SupportDomain [Vùng Hỗ trợ - Supporting]
        DocService["Document Service\n(Chỉ VIP: Xử lý file, Docling, RAG)"]
    end

    %% Nhóm Generic Services (Vùng Chung)
    subgraph GenericDomain [Vùng Chung - Generic]
        UserService["User Service\n(Quản lý Profile, Auth Google)"]
        SettingService["Setting Service\n(Lưu cấu hình User)"]
        SubService["Subscription Service\n(Quản lý Plan, Coupon, Invoice)"]
    end

    %% External Systems
    LLM(("LLM"))
    Payment(("Cổng Thanh Toán\n(VNPay, Momo, Zalo - DDD Interface)"))

    %% --- ĐỊNH NGHĨA LUỒNG GIAO TIẾP ---

    %% Gateway to Services
    Gateway -->|"Auth, Profile, Upload Avatar"| UserService
    Gateway -->|"GET/POST Settings"| SettingService
    Gateway -->|"Mua gói, Hủy gói"| SubService
    Gateway -->|"Upload File (VIP)"| DocService
    Gateway <-->|"Nhận Request / Gửi response"| ConvService

    %% Service to Database/Storage
    UserService <-->|"Đọc/Ghi/Upload"| SupabaseDB
    SettingService <-->|"RESTful API"| NeonDB_Setting

    %% Payment Luồng
    SubService <-->|"Xử lý giao dịch"| Payment
    SubService -->|"Bắn Event: payment_success"| Kafka
    SubService <-->|"Lên lịch tác vụ (BullMQ)"| Redis

    %% Document Processing Luồng
    DocService -->|"Lưu file vật lý"| R2
    DocService -->|"Trích xuất & Vector hóa (Docling)"| Qdrant

    %% Conversation & Chatbot Luồng (Quan trọng)
    ConvService <-->|"gRPC / gRPC Stream\n(Gửi Text, ID, File VIP)"| ChatbotService
    ConvService -->|"Bắn Event: Xóa Chat"| Kafka

    ChatbotService <-->|"Truy vấn VBPL"| Pinecone
    ChatbotService <-->|"Truy vấn Pháp điển"| NeonDB_Phapdien
    ChatbotService <-->|"Truy vấn File VIP"| Qdrant
    ChatbotService <-->|"Suy luận Agentic AI"| LLM

    %% --- LUỒNG CONSUMER NHẬN EVENT TỪ KAFKA ---
    Kafka -.->|"Lắng nghe: payment_success\n(Mở khóa VIP tải file)"| DocService
    Kafka -.->|"Lắng nghe: delete_chat\n(Xóa lịch sử AI context)"| ChatbotService

    %% Style Định dạng màu sắc chung
    classDef core fill:#e1f5fe,stroke:#03a9f4,stroke-width:2px,color:#000
    classDef support fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px,color:#000
    classDef generic fill:#fff3e0,stroke:#ff9800,stroke-width:2px,color:#000
    classDef db fill:#e8f5e9,stroke:#4caf50,stroke-width:2px,color:#000

    class ConvService,ChatbotService core
    class DocService support
    class UserService,SettingService,SubService generic
    class SupabaseDB,NeonDB_Setting,NeonDB_Phapdien,Pinecone,Qdrant,R2 db

    %% --- TÔ MÀU ĐỘC LẬP THEO YÊU CẦU ---
    style Redis fill:#ffebee,stroke:#d32f2f,stroke-width:2px,color:#c62828
    style Kafka fill:#ffe0b2,stroke:#f57c00,stroke-width:2px,color:#e65100
    style Payment fill:#fffde7,stroke:#fbc02d,stroke-width:2px,color:#000
    style Client fill:#e3f2fd,stroke:#1e88e5,stroke-width:2px,color:#000
    style LLM fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,color:#000
